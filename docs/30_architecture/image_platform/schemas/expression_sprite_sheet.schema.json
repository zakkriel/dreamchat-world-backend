{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dreamchat.ai/schemas/expression_sprite_sheet.schema.json",
  "title": "ExpressionSpriteSheetContract",
  "type": "object",
  "required": ["rows", "columns", "expression_order"],
  "properties": {
    "rows": {"type": "integer", "minimum": 1},
    "columns": {"type": "integer", "minimum": 1},
    "expression_order": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "safe_margin_px": {"type": "integer", "minimum": 0, "default": 0},
    "allow_text_labels": {"type": "boolean", "default": false},
    "allow_internal_frames": {"type": "boolean", "default": false},
    "camera_angle": {"type": "string", "default": "front"},
    "crop_style": {"type": "string", "enum": ["portrait", "bust", "headshot"], "default": "portrait"}
  }
}
