{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "scene_current/1",
  "title": "scene_current/1 — where you are, who is present, what matters now (GET /worlds/{w}/scene/current)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "place", "participants", "now", "journey", "current"],
  "properties": {
    "schema_version": { "const": "scene_current/1" },
    "place": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "description", "tone"],
      "properties": {
        "id":          { "type": "string", "format": "uuid" },
        "label":       { "type": "string" },
        "description": { "type": ["string", "null"] },
        "tone":        { "type": ["string", "null"] }
      }
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "kind"],
        "properties": {
          "id":    { "type": "string", "format": "uuid" },
          "label": { "type": "string" },
          "kind":  { "const": "actor" }
        }
      }
    },
    "now": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tick", "display_label"],
      "properties": {
        "tick":          { "type": "integer" },
        "display_label": { "type": ["string", "null"] }
      }
    },
    "journey": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/journey_block" }
      ]
    },
    "current": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "journey_block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active", "kind", "goal_label", "where_label", "progress", "legs_done", "legs_total", "interruptible", "status"],
      "properties": {
        "active":        { "type": "boolean" },
        "kind":          { "enum": ["travel", "wait", "watch"] },
        "goal_label":    { "type": ["string", "null"] },
        "where_label":   { "type": ["string", "null"] },
        "progress":      { "type": "number", "minimum": 0, "maximum": 1 },
        "legs_done":     { "type": "integer", "minimum": 0 },
        "legs_total":    { "type": "integer", "minimum": 0 },
        "interruptible": { "type": "boolean" },
        "status":        { "enum": ["active", "arrived", "ended"] }
      }
    }
  }
}
