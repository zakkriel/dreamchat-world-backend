{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "world_actor/1",
  "title": "world_actor/1 — ONE authored intrusion: the acting world entity's actor_id + its Attempt (the closed six-type vocabulary, no UNRESOLVED/QUERY — the World Actor always ACTS)",
  "type": "object",
  "required": ["actor_id", "attempt"],
  "properties": {
    "actor_id": {"type": "string", "format": "uuid"},
    "attempt": {
      "type": "object",
      "oneOf": [
        {"properties": {"type": {"const": "ActorMoved"}, "stated": {"type": "string", "minLength": 1}, "to_target_id": {"type": "string", "format": "uuid"}}, "required": ["type", "stated", "to_target_id"], "additionalProperties": false},
        {"properties": {"type": {"const": "Communicated"}, "stated": {"type": "string", "minLength": 1}, "listener_id": {"type": "string", "format": "uuid"}, "content": {"type": "string", "minLength": 1}, "duration_class": {"type": "string", "enum": ["instant","short","medium","long","extremely_long"]}}, "required": ["type", "stated", "listener_id", "content"], "additionalProperties": false},
        {"properties": {"type": {"const": "ObjectRelocated"}, "stated": {"type": "string", "minLength": 1}, "object_id": {"type": "string", "format": "uuid"}, "dest_kind": {"enum": ["actor", "location", "container"]}, "dest_id": {"type": "string", "format": "uuid"}, "duration_class": {"type": "string", "enum": ["instant","short","medium","long","extremely_long"]}}, "required": ["type", "stated", "object_id", "dest_kind", "dest_id"], "additionalProperties": false},
        {"properties": {"type": {"const": "OwnershipAccessChanged"}, "stated": {"type": "string", "minLength": 1}, "target_id": {"type": "string", "format": "uuid"}, "grantee_id": {"type": "string", "format": "uuid"}, "duration_class": {"type": "string", "enum": ["instant","short","medium","long","extremely_long"]}}, "required": ["type", "stated", "target_id"], "additionalProperties": false},
        {"properties": {"type": {"const": "EntityCreated"}, "stated": {"type": "string", "minLength": 1}, "component_ids": {"type": "array", "items": {"type": "string", "format": "uuid"}}, "duration_class": {"type": "string", "enum": ["instant","short","medium","long","extremely_long"]}}, "required": ["type", "stated"], "additionalProperties": false},
        {"properties": {"type": {"const": "EntityDestroyed"}, "stated": {"type": "string", "minLength": 1}, "target_id": {"type": "string", "format": "uuid"}, "duration_class": {"type": "string", "enum": ["instant","short","medium","long","extremely_long"]}}, "required": ["type", "stated", "target_id"], "additionalProperties": false},
        {"properties": {"type": {"const": "AttributeChanged"}, "stated": {"type": "string", "minLength": 1}, "target_id": {"type": "string", "format": "uuid"}, "duration_class": {"type": "string", "enum": ["instant","short","medium","long","extremely_long"]}}, "required": ["type", "stated", "target_id"], "additionalProperties": false}
      ]
    }
  },
  "additionalProperties": false
}
