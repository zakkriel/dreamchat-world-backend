                    "entity_id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "attr": {
                      "type": "string",
                      "minLength": 1
                    },
                    "value": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "entity_id",
