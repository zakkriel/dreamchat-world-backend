        "rolls"
      ],
      "properties": {
        "clock_delta_s": {
          "type": "integer"
        },
        "fired_scheduled": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rolls": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/trace_roll"
          }
        },
        "eruption": {
          "$ref": "#/$defs/trace_element"
        }
      }
    },
    "trace_roll": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tier",
        "chance",
        "roll",
        "fired"
      ],
      "properties": {
        "tier": {
          "type": "string"
        },
        "chance": {
          "type": "number"
        },
        "roll": {
          "type": "number"
        },
        "fired": {
          "type": "boolean"
        }
      }
    },
    "attempt": {
      "type": "object",
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "ActorMoved"
            },
            "stated": {
              "type": "string",
              "minLength": 1
            },
            "to_target_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "type",
            "stated",
            "to_target_id"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": {
              "const": "Communicated"
            },
            "stated": {
              "type": "string",
              "minLength": 1
            },
            "listener_id": {
              "type": "string",
              "format": "uuid"
            },
            "content": {
              "type": "string",
              "minLength": 1
            },
            "duration_class": {
              "type": "string",
              "enum": [
                "instant",
                "short",
                "medium",
                "long",
                "extremely_long"
              ]
            },
            "sustain": {
              "type": "object",
              "oneOf": [
                {
                  "properties": {
                    "kind": {
                      "const": "for"
                    },
                    "seconds": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "kind",
                    "seconds"
                  ],
                  "additionalProperties": false
                },
                {
                  "properties": {
                    "kind": {
                      "const": "until_at"
                    },
                    "entity_id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "place_id": {
                      "type": "string",
                      "format": "uuid"
                    }
                  },
                  "required": [
                    "kind",
                    "entity_id",
                    "place_id"
                  ],
                  "additionalProperties": false
                },
                {
                  "properties": {
                    "kind": {
                      "const": "until_attr"
                    },
                    "entity_id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "attr": {
                      "type": "string",
                      "minLength": 1
                    },
                    "value": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "entity_id",
                    "attr",
                    "value"
