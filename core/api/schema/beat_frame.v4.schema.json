{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "beat_frame/4",
  "title": "beat_frame/4 \u2014 one SSE frame of POST /worlds/{w}/beats (design \u00a74.8). Supersedes beat_frame/3: a narration message now carries `quote`, the verbatim spoken words, as a field separate from the staging prose in `text`.",
  "type": "object",
  "oneOf": [
    {
      "$ref": "#/$defs/interpretation_frame"
    },
    {
      "$ref": "#/$defs/narration_frame"
    },
    {
      "$ref": "#/$defs/scene_frame"
    },
    {
      "$ref": "#/$defs/journey_frame"
    },
    {
      "$ref": "#/$defs/result_frame"
    },
    {
      "$ref": "#/$defs/error_frame"
    },
    {
      "$ref": "#/$defs/trace_frame"
    }
  ],
  "$defs": {
    "interpretation_frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "chain"
      ],
      "properties": {
        "schema_version": {
          "const": "beat_frame/4"
        },
        "kind": {
          "const": "interpretation"
        },
        "chain": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/attempt"
          }
        }
      }
    },
    "narration_frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "message"
      ],
      "properties": {
        "schema_version": {
          "const": "beat_frame/4"
        },
        "kind": {
          "const": "narration"
        },
        "message": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "speaker_id",
            "speaker_label",
            "kind",
            "text",
            "quote"
          ],
          "properties": {
            "speaker_id": {
              "type": [
                "string",
                "null"
              ],
              "format": "uuid"
            },
            "speaker_label": {
              "type": "string"
            },
            "kind": {
              "enum": [
                "narration",
                "speech",
                "action"
              ]
            },
            "text": {
              "type": "string",
              "description": "Prose. The whole segment for narration and action; for speech it is the STAGING around the line and may be empty when the line is delivered bare."
            },
            "quote": {
              "type": [
                "string",
                "null"
              ],
              "description": "The verbatim spoken words, without quotation marks or attribution. Non-empty exactly when kind is speech; null otherwise. Render it as speech; render `text` as prose."
            }
          }
        }
      }
    },
    "scene_frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "scene"
      ],
      "properties": {
        "schema_version": {
          "const": "beat_frame/4"
        },
        "kind": {
          "const": "scene"
        },
        "scene": {
          "$ref": "#/$defs/scene_current"
        }
      }
    },
    "journey_frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "journey"
      ],
      "properties": {
        "schema_version": {
          "const": "beat_frame/4"
        },
        "kind": {
          "const": "journey"
        },
        "journey": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/journey_block"
            }
          ]
        }
      }
    },
    "result_frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "result"
      ],
      "properties": {
        "schema_version": {
          "const": "beat_frame/4"
        },
        "kind": {
          "const": "result"
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "committed",
            "halt_reason",
            "ticks_advanced",
            "unresolved_candidates",
            "telegraphs"
          ],
          "properties": {
            "committed": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "halt_reason": {
              "type": "string"
            },
            "ticks_advanced": {
              "type": "integer"
            },
            "unresolved_candidates": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "label"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "telegraphs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "error_frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "message"
      ],
      "properties": {
        "schema_version": {
          "const": "beat_frame/4"
        },
        "kind": {
          "const": "error"
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "trace_frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "reasoning_log"
      ],
      "properties": {
        "schema_version": {
          "const": "beat_frame/4"
        },
        "kind": {
          "const": "trace"
        },
        "reasoning_log": {
          "$ref": "#/$defs/beat_trace"
        }
      }
    },
    "beat_trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decompose",
        "halt_reason",
        "committed"
      ],
      "properties": {
        "decompose": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/trace_element"
          }
        },
        "world_first": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/trace_decision"
          }
        },
        "attempts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/trace_attempt"
          }
        },
        "rulings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/trace_ruling"
          }
        },
        "queries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/trace_query"
          }
        },
        "world_turn": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/trace_world_turn"
          }
        },
        "halt_reason": {
          "type": "string"
        },
        "committed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "trace_element": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "stated": {
          "type": "string"
        },
        "ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    },
    "trace_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_id",
        "decision"
      ],
      "properties": {
        "actor_id": {
          "type": "string",
          "format": "uuid"
        },
        "decision": {
          "enum": [
            "none",
            "commit",
            "telegraph"
          ]
        },
        "stated": {
          "type": "string"
        }
      }
    },
    "trace_attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "stated": {
          "type": "string"
        },
        "fact_sheet": {},
        "move_duration_s": {
          "type": "integer"
        },
        "budget_remaining_before": {
          "type": "integer"
        },
        "budget_remaining_after": {
          "type": "integer"
        },
        "fit": {
          "type": "boolean"
        }
      }
    },
    "trace_ruling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reasoning",
        "therefore"
      ],
      "properties": {
        "actor_ids": {
          "type": "array",
