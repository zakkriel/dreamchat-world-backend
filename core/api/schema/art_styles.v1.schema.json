{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "art_styles/1",
  "title": "art_styles/1 — GET /worlds/art-styles: selectable world art styles in display order.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "styles"],
  "properties": {
    "schema_version": { "const": "art_styles/1" },
    "styles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "label", "blurb"],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "blurb": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
