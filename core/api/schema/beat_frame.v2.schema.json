            "stated",
            "query_target_ids"
          ],
          "additionalProperties": false
        }
      ]
    },
    "scene_current": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "place",
        "participants",
        "now",
        "journey",
        "current"
      ],
      "properties": {
        "schema_version": {
          "const": "scene_current/2"
        },
        "place": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "label",
            "description",
            "tone"
          ],
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "label": {
              "type": "string"
            },
            "description": {
              "type": [
                "string",
                "null"
              ]
            },
            "tone": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "participants": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "kind",
              "image"
            ],
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "label": {
                "type": "string"
              },
              "kind": {
                "const": "actor"
              },
              "image": {
                "description": "Image reference or null. Mirrors scene_current/2's participant image; see that schema. The nested scene payload carries its OWN schema_version, which is how a scene change is announced without moving beat_frame's.",
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "schema_version",
                      "asset_id",
                      "path"
                    ],
                    "properties": {
                      "schema_version": {
                        "const": "image_ref/1"
                      },
                      "asset_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "path": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "now": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tick",
            "display_label"
          ],
          "properties": {
            "tick": {
              "type": "integer"
            },
            "display_label": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "journey": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/journey_block"
            }
          ]
        },
        "current": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "journey_block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active",
        "kind",
        "goal_label",
        "where_label",
        "progress",
        "legs_done",
        "legs_total",
        "interruptible",
        "status"
      ],
      "properties": {
        "active": {
          "type": "boolean"
        },
        "kind": {
          "enum": [
            "travel",
            "wait",
            "watch"
          ]
        },
        "goal_label": {
          "type": [
            "string",
            "null"
          ]
        },
        "where_label": {
          "type": [
            "string",
            "null"
          ]
        },
        "progress": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "legs_done": {
          "type": "integer",
          "minimum": 0
        },
        "legs_total": {
          "type": "integer",
          "minimum": 0
        },
        "interruptible": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "active",
            "arrived",
            "ended"
          ]
        }
      }
    }
  }
}
