{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "scene_current/4",
  "title": "scene_current/4 \u2014 where you are, who is present, what matters now (GET /worlds/{w}/scene/current)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "place",
    "participants",
    "now",
    "journey",
    "current"
  ],
  "properties": {
    "schema_version": {
      "const": "scene_current/4"
    },
    "place": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "description",
        "tone",
        "image"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "tone": {
          "type": [
            "string",
            "null"
          ]
        },
        "image": {
          "description": "The play-surface BACKDROP for the place the viewer stands in. Not perception-scoped, for the same reason a portrait is not: the room you are standing in is not a secret, and what the viewer KNOWS about it is already carried by label and description. Image reference, or null when there is no picture yet \u2014 the ordinary state, and what the frontend's placeholder is for. It swaps in on a later read with no re-request and no subscription. Carries an asset id and a PATH back to the world backend, never a presigned URL: those expire (~15 min), so an embedded one would make this payload rot in any cache or log. Fetch as {apiBase}{path}, optionally ?tier=thumbnail|preview|final (256/768/1024, default preview); the backend mints a fresh short-lived URL per read and redirects.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "schema_version",
                "asset_id",
                "path"
              ],
              "properties": {
                "schema_version": {
                  "const": "image_ref/1"
                },
                "asset_id": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                }
              }
            }
          ]
        }
      }
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "kind",
          "image",
          "sprites"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "label": {
            "type": "string"
          },
          "kind": {
            "const": "actor"
          },
          "image": {
            "description": "Image reference, or null when there is no picture yet \u2014 the ordinary state, and what the frontend's placeholder silhouette is for. It swaps in on a later read with no re-request and no subscription. Carries an asset id and a PATH back to the world backend, never a presigned URL: those expire (~15 min), so an embedded one would make this payload rot in any cache or log. Fetch as {apiBase}{path}, optionally ?tier=thumbnail|preview|final (256/768/1024, default preview); the backend mints a fresh short-lived URL per read and redirects.",
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "schema_version",
                  "asset_id",
                  "path"
                ],
                "properties": {
                  "schema_version": {
                    "const": "image_ref/1"
                  },
                  "asset_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            ]
          },
          "sprites": {
            "description": "Sprite set for the participant. Null until all four emotion variants exist; non-null only when every variant is filled.",
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "neutral",
                  "happy",
                  "angry",
                  "sad"
                ],
                "properties": {
                  "neutral": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "schema_version",
                      "asset_id",
                      "path"
                    ],
                    "properties": {
                      "schema_version": {
                        "const": "image_ref/1"
                      },
                      "asset_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "path": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "happy": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "schema_version",
                      "asset_id",
                      "path"
                    ],
                    "properties": {
                      "schema_version": {
                        "const": "image_ref/1"
                      },
                      "asset_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "path": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "angry": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "schema_version",
                      "asset_id",
                      "path"
                    ],
                    "properties": {
                      "schema_version": {
                        "const": "image_ref/1"
                      },
                      "asset_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "path": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "sad": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "schema_version",
                      "asset_id",
                      "path"
                    ],
                    "properties": {
                      "schema_version": {
                        "const": "image_ref/1"
                      },
                      "asset_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "path": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    "now": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tick",
        "display_label"
      ],
      "properties": {
        "tick": {
          "type": "integer"
        },
        "display_label": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "journey": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/journey_block"
        }
      ]
    },
    "current": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "journey_block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active",
        "kind",
        "goal_label",
        "where_label",
        "progress",
        "legs_done",
        "legs_total",
        "interruptible",
        "status"
      ],
      "properties": {
        "active": {
          "type": "boolean"
        },
        "kind": {
          "enum": [
            "travel",
            "wait",
            "watch"
          ]
        },
        "goal_label": {
          "type": [
            "string",
            "null"
          ]
        },
        "where_label": {
          "type": [
            "string",
            "null"
          ]
        },
        "progress": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "legs_done": {
          "type": "integer",
          "minimum": 0
        },
        "legs_total": {
          "type": "integer",
          "minimum": 0
        },
        "interruptible": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "active",
            "arrived",
            "ended"
          ]
        }
      }
    }
  }
}
