# Local dev: the keyless path. Every seat binds a deterministic stand-in, no provider, no bill.
DREAMCHAT_BRIDGE=fake
DATABASE_URL=postgres://postgres:postgres@db:5432/dreamchat?sslmode=disable

# ── LIVE SEATS ──────────────────────────────────────────────────────────────────────────────────
# There is NO default provider: unset all of the below with DREAMCHAT_BRIDGE unset and the server
# refuses to boot, naming the missing variable. That is deliberate — a default is what quietly bills
# someone (founder ruling, 2026-08-07: never default seats to Anthropic).
#
# <NAME> below is an alias YOU choose. It appears nowhere in the code; the code knows only dialects.
#
# DREAMCHAT_SEAT_DEFAULT=cheap:some-small-model
# DREAMCHAT_SEATS=narrate=prose:some-big-model,world_actor=prose:some-big-model
#
# DREAMCHAT_PROVIDER_CHEAP_BASE_URL=https://api.example.com/v1
# DREAMCHAT_PROVIDER_CHEAP_API_KEY=...
# DREAMCHAT_PROVIDER_CHEAP_DIALECT=openai-compat      # default; or: anthropic
# DREAMCHAT_PROVIDER_CHEAP_JSON_MODE=json_object      # default; or: json_schema where supported
#
# Routing policy for an aggregator that takes a provider-preferences object. Raw JSON, passed
# through verbatim, validated at boot. Per-seat override: DREAMCHAT_SEAT_ROUTING_<SEAT>.
# Sampling temperature. UNSET means unsent — the provider's default stands. Set it to 0 on the
# MECHANICAL seats (decompose, resolve): their output is a classification, not a performance, and a
# schema does not make a sampling default deterministic. Per-seat: DREAMCHAT_SEAT_TEMPERATURE_<SEAT>.
# DREAMCHAT_PROVIDER_CHEAP_TEMPERATURE=0
#
# Reasoning policy, raw JSON, passed through verbatim. UNSET LEAVES THE MODEL'S OWN DEFAULT, which is
# not neutral: a model advertising default_effort "high" spends ~80% of max_tokens thinking before a
# token of answer, which is how a 1024-token budget returns finish_reason "length" and no content.
# {"effort":"none"} disables it. Per-seat: DREAMCHAT_SEAT_REASONING_<SEAT>.
# DREAMCHAT_PROVIDER_CHEAP_REASONING={"effort":"none"}
#
# Completion budget. NOT optional against an aggregator: with no max_tokens it reserves the model's
# full completion window and refuses the call. Per-seat: DREAMCHAT_SEAT_MAX_TOKENS_<SEAT>.
# DREAMCHAT_PROVIDER_CHEAP_MAX_TOKENS=2048
#
# DREAMCHAT_PROVIDER_CHEAP_ROUTING={"only":["..."],"ignore":["..."],"data_collection":"deny","require_parameters":true}
