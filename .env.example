# Local dev: the keyless path. Every seat binds a deterministic stand-in, no provider, no bill.
DREAMCHAT_BRIDGE=fake
DATABASE_URL=postgres://postgres:postgres@db:5432/dreamchat?sslmode=disable

# ── LIVE SEATS ──────────────────────────────────────────────────────────────────────────────────
# There is NO default provider: unset all of the below with DREAMCHAT_BRIDGE unset and the server
# refuses to boot, naming the missing variable. That is deliberate — a default is what quietly bills
# someone (founder ruling, 2026-08-07: never default seats to Anthropic).
#
# <NAME> below is an alias YOU choose. It appears nowhere in the code; the code knows only dialects.
#
# DREAMCHAT_SEAT_DEFAULT=cheap:some-small-model
# DREAMCHAT_SEATS=narrate=prose:some-big-model,world_actor=prose:some-big-model
#
# DREAMCHAT_PROVIDER_CHEAP_BASE_URL=https://api.example.com/v1
# DREAMCHAT_PROVIDER_CHEAP_API_KEY=...
# DREAMCHAT_PROVIDER_CHEAP_DIALECT=openai-compat      # default; or: anthropic
# DREAMCHAT_PROVIDER_CHEAP_JSON_MODE=json_object      # default; or: json_schema where supported
